# Blogdex CLI 환경변수 설정 파일
# 이 파일을 .env로 복사하고 값을 채우세요:
#   cp cli/.env.example cli/.env

# 필수: Workers API 인증 키 (config.py에서 읽음)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
BLOGDEX_API_KEY=your_key_here

# ── 경로 설정 (기본값: 프로젝트 루트 기준 상대경로) ──────────────────
# CLI 스크립트가 출처와 CSV를 읽을 경로입니다.
# 기본값을 사용하려면 주석 처리하거나 비워두세요.
BLOGDEX_PUBLISH_CONFIG=     # 기본: <프로젝트루트>/publish_config.yaml
BLOGDEX_CSV_DIR=            # 기본: <프로젝트루트>/sitemap-title

# 텔레그램 알림 (선택, daily_sync.py에서 사용)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Naver API (필수: senior 뉴스 수집 + 키워드 스카우트)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Bing Webmaster API (선택, daily_sync.py에서 사용)
# 단일 계정:
BING_API_KEY=your_bing_api_key_here
BING_ACCOUNT=your_bing_account_here

# 추가 Bing 계정 (선택):
BING_API_KEY_2=your_second_bing_key_here
BING_ACCOUNT_2=your_second_account_here
BING_API_KEY_3=your_third_bing_key_here
BING_ACCOUNT_3=your_third_account_here
